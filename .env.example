# ============================================
# Bot de Inteligência Econômica - Configuração
# ============================================
# Copie este arquivo para .env e preencha os valores

# --- Telegram ---
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# --- E-mail (Gmail com App Password) ---
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_de_app_aqui
EMAIL_RECIPIENTS=destinatario1@email.com,destinatario2@email.com

# --- Instagram (opcional, mas sem login o Instagram bloqueia a coleta) ---
# 1) Rode uma vez no terminal:  .venv\Scripts\instaloader --login SEU_USUARIO
# 2) Coloque o usuário aqui (a senha NÃO fica salva no projeto):
INSTAGRAM_USERNAME=
